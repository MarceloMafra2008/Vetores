//Uma empresa deseja acompanhar o consumo diario de energia eletrica de um equipamento durante
//um periodo de dez dias. Para isso, desenvolva um programa em linguagem C que leia o consumo registrado em cada dia, expresso em kWh
//, e apresente um relatorio com as seguintes informacoes.
// ---> O consumo registrado em cada dia do periodo
// ---> O consumo total e o consumo medio diario
// ---> O dia em que ocorreu o maior consumo de o valor registrado nesse dia.
// ---> A quantidade de dias em que o consumo ficou acima da media diaria
// ---> os dias em que o consumo ficou abaixo de um limite de 100 kWh

//Requisitos
//---> Os valores de consumo devem ser informados pelo usuario
// --->O programa deve processar os dados lidos para obter todas as informacoes solicitadas 
// ---> Os resultados devem ser apresentados de forma organizada, com indentificaçao dos dias correspondentes

#include <stdio.h>

int main()
{
   float vet[10], total=0, medio=0, maior=0;
   int i, qtdmaior=0, qtdbaixo=0, dia;
   
   
   for(i=0; i<10; i++)
   {
       printf("\nInforme o valor do consumo do dia[%d]:", i + 1);
       scanf("%f", &vet[i]);
       while(vet[i] < 0)
       {
           printf("\nINCORRETO!");
           printf("\nInforme o valor do consumo do dia[%d]:", i + 1);
           scanf("%f", &vet[i]);
       }
       if(vet[i]<100)
       {
           qtdbaixo ++;
       }
       total = total + vet[i];
   }
   
   medio = total/10;
   for(i=0; i<10; i++)
   {
       if(vet[i]>medio)
       {
           qtdmaior ++;
       }
   }
   
   
   
   printf("\n");
   printf("\nTABELA DOS DIAS!");
   for(i=0;i<10; i++)
   {
       printf("\nConsumo do dia[%d]:%.2f", i+ 1, vet[i]);
   }
   
   maior = vet[0];
   
   for(i=0; i<10; i++)
   {
       if(vet[i]>maior)
       {
           maior = vet[i];
           dia = i + 1;
       }
   }
   printf("\n");
   printf("\nRESULTADOS!");
   printf("\n");
   printf("\nMaior consumo[%.2f], no dia[%d]", maior, dia);
   printf("\nConsumo total:%.2f", total);
   printf("\nConsumo medio:%.2f", medio);
   printf("\nQuantidade de dias do consumo acima da media:%d", qtdmaior);
   printf("\nQuantidade de dias do consumo abaixo da media:%d", qtdbaixo);
   
   
}
