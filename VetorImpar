1)	Faça um programa que lê valores inteiros maiores que 10 em um vetor de 7 posições. Posteriormente crie um outro vetor com os elementos ímpares do 
vetor original. Ao final do programa imprima os dois vetores criados.



#include <stdio.h>
int main()
{
    int vet[7], imp[7], i, cont=0;
    
    for(i=0; i<7; i++)
    {
        printf("\nInsira um valor maior que 10:");
        scanf("%d", &vet[i]);
        
        while(vet[i] < 10)
        {
            printf("\nValor incorreto");
            printf("\nInsira novamente um valor maior que 10:");
            scanf("%d", &vet[i]);
        }
        if(vet[i] %2 != 0)
        {
            imp[cont] = vet[i];
            cont ++;
        }
        
    }
    printf("\nVetor Original:");
    for(i=0;i<7;i++)
    {
        printf("%d,", vet[i]);
    }
    printf("\n");
    printf("\nImpares:");
    for(i=0; i<cont; i++)
    {
        printf("%d,", imp[i]);
    }
}
